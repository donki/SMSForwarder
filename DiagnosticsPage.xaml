<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMSForwarder.DiagnosticsPage"
             Title="Diagnostics">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Cabecera -->
            <VerticalStackLayout Spacing="8">
                <Label x:Name="TitleLabel"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       HorizontalOptions="Center" />
                <Label x:Name="SubtitleLabel"
                       Style="{StaticResource HintText}"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Tarjetas de estado -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Image Source="ic_lock.png" Aspect="AspectFit" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                        <Label x:Name="PermissionsLabel" Style="{StaticResource BodyText}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="PermissionsStatus" Style="{StaticResource HintText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Image Source="ic_phone.png" Aspect="AspectFit" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                        <Label x:Name="NumbersLabel" Style="{StaticResource BodyText}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="PhonesCount" Text="0" Style="{StaticResource HintText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Permisos -->
            <VerticalStackLayout Spacing="12">
                <Label x:Name="PermissionsSetupLabel"
                       Style="{StaticResource CardTitle}"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0" />

                <Button x:Name="CheckPermissionsButton" ImageSource="ic_search_w.png" ContentLayout="Left,10" LineBreakMode="WordWrap"
                        Clicked="OnCheckPermissionsClicked"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="14" />

                <Button x:Name="ConfigureAllButton" ImageSource="ic_settings_w.png" ContentLayout="Left,10" LineBreakMode="WordWrap"
                        Clicked="OnConfigureAllPermissionsClicked"
                        Style="{StaticResource PrimaryButton}"
                        BackgroundColor="{StaticResource Accent}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            x:Name="BatteryButton" ImageSource="ic_battery_w.png" ContentLayout="Left,8"
                            Clicked="OnBatteryOptimizationClicked"
                            Style="{StaticResource AccentButton}"
                            FontSize="12" />

                    <Button Grid.Column="1"
                            x:Name="AutostartButton" ImageSource="ic_power.png" ContentLayout="Left,8"
                            Clicked="OnAutostartClicked"
                            Style="{StaticResource OutlineButton}"
                            FontSize="12" />
                </Grid>

                <Border Style="{StaticResource Card}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                        Padding="12">
                    <Label x:Name="HintLabel"
                           Style="{StaticResource HintText}"
                           LineBreakMode="WordWrap" />
                </Border>
            </VerticalStackLayout>

            <!-- Herramientas -->
            <VerticalStackLayout Spacing="12">
                <Label x:Name="ToolsLabel"
                       Style="{StaticResource CardTitle}"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       HorizontalOptions="Center"
                       Margin="0,16,0,0" />

                <Button x:Name="RefreshButton" ImageSource="ic_refresh_w.png" ContentLayout="Left,10" LineBreakMode="WordWrap"
                        Clicked="OnRefreshClicked"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="14" />
            </VerticalStackLayout>

            <!-- Registro -->
            <VerticalStackLayout Spacing="12">
                <Label x:Name="ActivityLogLabel"
                       Style="{StaticResource CardTitle}"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       HorizontalOptions="Center" />

                <Border Style="{StaticResource Card}" Padding="12">
                    <ScrollView HeightRequest="180">
                        <Label x:Name="LogsLabel"
                                                              FontSize="12"
                               FontFamily="Monospace"
                               Style="{StaticResource BodyText}"
                               LineBreakMode="WordWrap" />
                    </ScrollView>
                </Border>

                <Button x:Name="ClearLogButton"
                        ImageSource="ic_delete.png"
                        ContentLayout="Left,10"
                        Clicked="OnClearLogsClicked"
                        Style="{StaticResource OutlineButton}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
