<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMSForwarder.MainPage"
             Title="Configuración">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Cabecera -->
            <VerticalStackLayout Spacing="8">
                <Label x:Name="TitleLabel"
                       Text="Configuración"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       HorizontalOptions="Center"/>
                <Label x:Name="SubtitleLabel"
                       Text="Configura los números donde reenviar SMS"
                       Style="{StaticResource HintText}"
                       FontSize="14"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Selector de idioma -->
            <VerticalStackLayout Spacing="8">
                <Label x:Name="LanguageLabel"
                       Text="Idioma"
                       Style="{StaticResource BodyText}"
                       FontAttributes="Bold"/>
                <!-- Botones de idioma con bandera: el idioma activo usa PrimaryButton (indigo relleno)
                     y el otro OutlineButton (contorno indigo). Mismo patron que FileManager. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="SpanishButton"
                            Grid.Column="0"
                            Text="Español"
                            FontSize="14"
                            ImageSource="ic_flag_es.png"
                            ContentLayout="Left,8"
                            Clicked="OnSpanishClicked"/>

                    <Button x:Name="EnglishButton"
                            Grid.Column="1"
                            Text="English"
                            FontSize="14"
                            ImageSource="ic_flag_gb.png"
                            ContentLayout="Left,8"
                            Clicked="OnEnglishClicked"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Entrada de numero -->
            <VerticalStackLayout Spacing="12">
                <Border Style="{StaticResource Card}" Padding="4">
                    <Entry x:Name="PhoneEntry"
                           Placeholder="Ej: +34 600 123 456"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           FontSize="16"/>
                </Border>

                <!-- Botones de accion -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="AddButton"
                            Grid.Column="0"
                            Text="Agregar número"
                            ImageSource="ic_add_w.png"
                            ContentLayout="Left,8"
                            Clicked="OnAddClicked"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="14"/>

                    <Button x:Name="ContactsButton"
                            Grid.Column="1"
                            Text="Contactos"
                            FontSize="14"
                            ImageSource="ic_group_w.png"
                            ContentLayout="Left,8"
                            Clicked="OnSelectFromContactsClicked"
                            Style="{StaticResource PrimaryButton}"
                            BackgroundColor="{StaticResource Accent}"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Lista de numeros -->
            <VerticalStackLayout Spacing="12">
                <Label x:Name="NumbersListLabel"
                       Text="Números configurados"
                       Style="{StaticResource CardTitle}"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0"/>

                <CollectionView x:Name="PhoneList" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,4">
                                <!-- Tocar la fila abre que SMS recibe ese numero (por defecto, todos).
                                     Borrar va por boton y no deslizando: el deslizamiento competia
                                     con el toque y acababa abriendo el numero (igual que pasaba en
                                     el buzon). -->
                                <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDestinationTapped" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0"
                                            BackgroundColor="{StaticResource PrimaryLight}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            VerticalOptions="Center">
                                        <Image Source="ic_phone.png"
                                               Aspect="AspectFit"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Margin="12,0,0,0">
                                        <Label Text="{Binding Phone}"
                                               Style="{StaticResource BodyText}"
                                               FontSize="16"/>
                                        <Label Text="{Binding Summary}"
                                               Style="{StaticResource HintText}"
                                               FontSize="12"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                    <Image Grid.Column="2"
                                           Source="ic_chevron_right.png"
                                           Aspect="AspectFit"
                                           WidthRequest="18"
                                           HeightRequest="18"
                                           VerticalOptions="Center"/>
                                    <ImageButton Grid.Column="3"
                                                 Source="ic_delete_danger.png"
                                                 Style="{StaticResource IconButtonPlain}"
                                                 Margin="8,0,0,0"
                                                 VerticalOptions="Center"
                                                 Clicked="OnDeleteClicked"
                                                 CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Informacion de ayuda -->
            <Border Style="{StaticResource Card}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                    Padding="16"
                    Margin="0,8,0,0">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Image Source="ic_info.png"
                               Aspect="AspectFit"
                               WidthRequest="18"
                               HeightRequest="18"
                               VerticalOptions="Center"/>
                        <Label x:Name="InfoTitle"
                               Grid.Column="1"
                               Text="Información"
                               Style="{StaticResource CardTitle}"
                               FontSize="14"/>
                    </Grid>
                    <Label x:Name="InfoText"
                           Text="• Los SMS recibidos se reenviarán automáticamente a estos números&#x0a;• Puedes escribir números manualmente o seleccionarlos desde tus contactos&#x0a;• Para configurar permisos avanzados, ve a la sección Diagnósticos&#x0a;• Toca la papelera de un número para eliminarlo"
                           Style="{StaticResource HintText}"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
