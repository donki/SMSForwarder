<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMSForwarder.Pages.DestinationPage">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- El numero de destino -->
            <Border Style="{StaticResource Card}">
                <Grid Padding="16,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            WidthRequest="32"
                            HeightRequest="32"
                            VerticalOptions="Center">
                        <Image Source="ic_phone.png" Aspect="AspectFit" WidthRequest="18" HeightRequest="18"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label x:Name="PhoneLabel"
                           Grid.Column="1"
                           Style="{StaticResource BodyText}"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Todo o solo lo que case. Apagado, salen las dos listas de abajo. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16,12" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label x:Name="AllLabel"
                               Grid.Column="0"
                               Style="{StaticResource BodyText}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Switch x:Name="AllSwitch"
                                Grid.Column="1"
                                OnColor="{StaticResource Primary}"
                                Toggled="OnAllToggled"
                                VerticalOptions="Center"/>
                    </Grid>
                    <Label x:Name="AllHint" Style="{StaticResource HintText}" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- Filtros: remitentes y palabras. Solo a la vista con el interruptor apagado. -->
            <VerticalStackLayout x:Name="FiltersPanel" Spacing="16" IsVisible="False">

                <!-- Remitentes -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Padding="16,12" Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image Source="ic_call.png" Aspect="AspectFit" WidthRequest="20" HeightRequest="20" VerticalOptions="Start" Margin="0,3,0,0"/>
                            <Label x:Name="SendersTitle" Grid.Column="1" Style="{StaticResource CardTitle}" LineBreakMode="WordWrap"/>
                        </Grid>
                        <Label x:Name="SendersHint" Style="{StaticResource HintText}" LineBreakMode="WordWrap"/>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="4">
                                <Entry x:Name="SenderEntry"
                                       Keyboard="Telephone"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       Completed="OnAddSenderClicked"/>
                            </Border>
                            <ImageButton x:Name="AddSenderButton"
                                         Grid.Column="1"
                                         Source="ic_add_w.png"
                                         Style="{StaticResource IconButtonFilled}"
                                         Clicked="OnAddSenderClicked"/>
                            <ImageButton x:Name="PickSenderButton"
                                         Grid.Column="2"
                                         Source="ic_group.png"
                                         Style="{StaticResource IconButton}"
                                         Clicked="OnPickSenderClicked"/>
                        </Grid>
                        <CollectionView x:Name="SendersList" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding .}"
                                               Style="{StaticResource BodyText}"
                                               VerticalOptions="Center"/>
                                        <ImageButton Grid.Column="1"
                                                     Source="ic_delete_danger.png"
                                                     Style="{StaticResource IconButtonPlain}"
                                                     Clicked="OnRemoveSenderClicked"
                                                     CommandParameter="{Binding .}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Palabras o frases -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Padding="16,12" Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image Source="ic_chat.png" Aspect="AspectFit" WidthRequest="20" HeightRequest="20" VerticalOptions="Start" Margin="0,3,0,0"/>
                            <Label x:Name="KeywordsTitle" Grid.Column="1" Style="{StaticResource CardTitle}" LineBreakMode="WordWrap"/>
                        </Grid>
                        <Label x:Name="KeywordsHint" Style="{StaticResource HintText}" LineBreakMode="WordWrap"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="4">
                                <Entry x:Name="KeywordEntry"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       Completed="OnAddKeywordClicked"/>
                            </Border>
                            <ImageButton x:Name="AddKeywordButton"
                                         Grid.Column="1"
                                         Source="ic_add_w.png"
                                         Style="{StaticResource IconButtonFilled}"
                                         Clicked="OnAddKeywordClicked"/>
                        </Grid>
                        <CollectionView x:Name="KeywordsList" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding .}"
                                               Style="{StaticResource BodyText}"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center"/>
                                        <ImageButton Grid.Column="1"
                                                     Source="ic_delete_danger.png"
                                                     Style="{StaticResource IconButtonPlain}"
                                                     Clicked="OnRemoveKeywordClicked"
                                                     CommandParameter="{Binding .}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Que le llega, en una frase -->
                <Border Style="{StaticResource Card}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                    <Label x:Name="SummaryLabel"
                           Padding="16,12"
                           Style="{StaticResource HintText}"
                           LineBreakMode="WordWrap"/>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
