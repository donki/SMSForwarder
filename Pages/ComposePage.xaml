<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMSForwarder.Pages.ComposePage"
             Title="Nuevo mensaje">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="16">

        <!-- Destinatario -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label x:Name="ToLabel"
                   Text="Para"
                   Style="{StaticResource BodyText}"
                   FontAttributes="Bold"/>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="4">
                    <Entry x:Name="ToEntry"
                           Placeholder="Ej: +34 600 123 456"
                           Keyboard="Telephone"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           FontSize="16"/>
                </Border>

                <Button x:Name="ContactsButton"
                        Grid.Column="1"
                        Text="👥"
                        FontSize="18"
                        WidthRequest="56"
                        Style="{StaticResource OutlineButton}"
                        Clicked="OnPickContactClicked"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Cuerpo del mensaje -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Label x:Name="BodyLabel"
                   Text="Mensaje"
                   Style="{StaticResource BodyText}"
                   FontAttributes="Bold"/>

            <Border Style="{StaticResource Card}" Padding="8" VerticalOptions="Fill">
                <Editor x:Name="BodyEditor"
                        Placeholder="Escribe tu mensaje"
                        AutoSize="Disabled"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        FontSize="16"
                        VerticalOptions="Fill"
                        TextChanged="OnBodyTextChanged"/>
            </Border>

            <Label x:Name="CounterLabel"
                   Text="0/160"
                   Style="{StaticResource HintText}"
                   HorizontalOptions="End"/>
        </VerticalStackLayout>

        <Button x:Name="SendButton"
                Grid.Row="2"
                Text="Enviar"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnSendClicked"/>
    </Grid>

</ContentPage>
