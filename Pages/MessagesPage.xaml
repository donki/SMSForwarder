<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SMSForwarder.Models"
             x:Class="SMSForwarder.Pages.MessagesPage"
             x:Name="PageRoot"
             Title="Mensajes">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,16,16,12" RowSpacing="12">

        <!-- Cabecera: aviso de app por defecto + selector de bandeja -->
        <VerticalStackLayout Grid.Row="0" Spacing="12">

            <!-- Solo visible mientras SMS Forwarder no sea la app de SMS del sistema.
                 Sin el rol no se puede borrar ni marcar leido en el proveedor. -->
            <Border x:Name="DefaultAppBanner"
                    Style="{StaticResource Card}"
                    IsVisible="False">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label x:Name="DefaultAppTitle"
                           Text="Hazla tu app de mensajes"
                           Style="{StaticResource CardTitle}"
                           FontSize="15"/>
                    <Label x:Name="DefaultAppText"
                           Text="Para escribir, borrar y marcar como leidos los mensajes, SMS Forwarder tiene que ser tu aplicacion de SMS predeterminada."
                           Style="{StaticResource HintText}"
                           LineBreakMode="WordWrap"/>
                    <Button x:Name="DefaultAppButton"
                            Text="Usar como predeterminada"
                            Style="{StaticResource PrimaryButton}"
                            LineBreakMode="WordWrap"
                            Clicked="OnMakeDefaultClicked"/>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                <!-- Cada bandeja con su icono y una palabra corta: con la letra del sistema en
                     grande, «Recibidos» partia la palabra por la mitad. El icono lo cambia el
                     code-behind al cambiar de estilo (blanco cuando el boton va relleno). -->
                <Button x:Name="InboxButton"
                        Grid.Column="0"
                        Text="Entrada"
                        FontSize="14"
                        ImageSource="ic_inbox_w.png"
                        ContentLayout="Left,8"
                        Clicked="OnInboxClicked"/>
                <Button x:Name="SentButton"
                        Grid.Column="1"
                        Text="Enviados"
                        FontSize="14"
                        ImageSource="ic_outbox.png"
                        ContentLayout="Left,8"
                        Clicked="OnSentClicked"/>
                <!-- Entrar y salir del modo de seleccion multiple -->
                <ImageButton x:Name="SelectModeButton"
                             Grid.Column="2"
                             Source="ic_select.png"
                             Style="{StaticResource IconButton}"
                             Clicked="OnSelectModeClicked"/>
                <ImageButton x:Name="RefreshButton"
                             Grid.Column="3"
                             Source="ic_refresh.png"
                             Style="{StaticResource IconButton}"
                             Clicked="OnRefreshClicked"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Lista de mensajes -->
        <!-- Abrir un mensaje va por seleccion y no por TapGestureRecognizer. Antes cada fila era un
             SwipeView para borrar deslizando, pero en Android el deslizamiento acababa abriendo el
             detalle (el SwipeView dentro del Border se come el gesto): ahora hay un boton de borrar
             en cada fila y un modo de seleccion multiple. -->
        <CollectionView x:Name="MessagesList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnMessageSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                    <Label x:Name="EmptyLabel"
                           Text="No hay mensajes"
                           Style="{StaticResource BodyText}"
                           FontSize="16"
                           HorizontalOptions="Center"/>
                    <Label x:Name="EmptyHintLabel"
                           Text="Los SMS que recibas apareceran aqui."
                           Style="{StaticResource HintText}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SmsMessageItem">
                    <Border Style="{StaticResource Card}" Margin="0,4">
                        <Grid Padding="16,12" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">

                            <!-- Casilla de seleccion: solo en el modo de seleccion multiple -->
                            <CheckBox Grid.Column="0"
                                      IsVisible="{Binding Source={x:Reference PageRoot}, Path=IsSelecting}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Color="{StaticResource Primary}"
                                      VerticalOptions="Center"
                                      CheckedChanged="OnItemCheckedChanged"/>

                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    VerticalOptions="Start">
                                <Image Source="{Binding DirectionIcon}"
                                       Aspect="AspectFit"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding DisplayAddress}"
                                           Style="{StaticResource BodyText}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           MaxLines="2"
                                           LineBreakMode="CharacterWrap"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding ListDateText}"
                                           Style="{StaticResource HintText}"
                                           FontSize="11"
                                           VerticalOptions="Center"/>
                                </Grid>
                                <Label Text="{Binding Snippet}"
                                       Style="{StaticResource BodyText}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <!-- Borrar este mensaje, sin deslizar -->
                            <ImageButton Grid.Column="3"
                                         Source="ic_delete_danger.png"
                                         Style="{StaticResource IconButtonPlain}"
                                         VerticalOptions="Center"
                                         IsVisible="{Binding Source={x:Reference PageRoot}, Path=IsNotSelecting}"
                                         Clicked="OnDeleteMessageClicked"
                                         CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Pie: redactar, o las acciones de la seleccion multiple -->
        <Grid Grid.Row="2">
            <Button x:Name="ComposeButton"
                    Text="Nuevo mensaje"
                    ImageSource="ic_edit_w.png"
                    ContentLayout="Left,10"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnComposeClicked"/>

            <Grid x:Name="SelectionBar"
                  IsVisible="False"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">
                <ImageButton x:Name="SelectAllButton"
                             Grid.Column="0"
                             Source="ic_check.png"
                             Style="{StaticResource IconButton}"
                             Clicked="OnSelectAllClicked"/>
                <Button x:Name="DeleteSelectedButton"
                        Grid.Column="1"
                        Text="Eliminar"
                        ImageSource="ic_delete_w.png"
                        ContentLayout="Left,10"
                        Style="{StaticResource PrimaryButton}"
                        BackgroundColor="{StaticResource Danger}"
                        IsEnabled="False"
                        Clicked="OnDeleteSelectedClicked"/>
                <ImageButton x:Name="CancelSelectionButton"
                             Grid.Column="2"
                             Source="ic_close.png"
                             Style="{StaticResource IconButton}"
                             Clicked="OnCancelSelectionClicked"/>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
