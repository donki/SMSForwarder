<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMSForwarder.Pages.MessageDetailPage">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,16,16,12" RowSpacing="12">

        <!-- Remitente o destinatario, con su boton de copiar al lado -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid Padding="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="AddressLabel"
                           Style="{StaticResource BodyText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation" />
                    <Label x:Name="DateLabel" Style="{StaticResource HintText}" />
                </VerticalStackLayout>
                <Button x:Name="CopyAddressButton"
                        Grid.Column="1"
                        Text="⧉"
                        FontSize="20"
                        WidthRequest="48"
                        Style="{StaticResource OutlineButton}"
                        Clicked="OnCopyAddressClicked" />
            </Grid>
        </Border>

        <!-- Texto completo del mensaje. Los enlaces van como tramos pulsables:
             el cuerpo se compone en el code-behind porque hay que trocearlo. -->
        <ScrollView Grid.Row="1">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16,14" Spacing="12">
                    <Label x:Name="BodyLabel"
                           Style="{StaticResource BodyText}"
                           LineBreakMode="WordWrap" />
                    <Button x:Name="CopyBodyButton"
                            Style="{StaticResource OutlineButton}"
                            Clicked="OnCopyBodyClicked" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <Button x:Name="ReplyButton"
                Grid.Row="2"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnReplyClicked" />
    </Grid>

</ContentPage>
