<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMSForwarder.Pages.MessageDetailPage">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,16,16,12" RowSpacing="12">

        <!-- Remitente o destinatario, con su boton de copiar al lado -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid Padding="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="AddressLabel"
                           Style="{StaticResource BodyText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation" />
                    <Label x:Name="DateLabel" Style="{StaticResource HintText}" />
                </VerticalStackLayout>
                <ImageButton x:Name="CopyAddressButton"
                             Grid.Column="1"
                             Source="ic_copy.png"
                             Style="{StaticResource IconButton}"
                             Clicked="OnCopyAddressClicked" />
            </Grid>
        </Border>

        <!-- Texto completo del mensaje. Los enlaces van como tramos pulsables:
             el cuerpo se compone en el code-behind porque hay que trocearlo. -->
        <ScrollView Grid.Row="1">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16,14" Spacing="12">
                    <Label x:Name="BodyLabel"
                           Style="{StaticResource BodyText}"
                           LineBreakMode="WordWrap" />
                    <Button x:Name="CopyBodyButton"
                            ImageSource="ic_copy.png"
                            ContentLayout="Left,10"
                            Style="{StaticResource OutlineButton}"
                            Clicked="OnCopyBodyClicked" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <!-- Lo de este mensaje: mandarselo a alguien o contestar al remitente -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="ForwardButton"
                        Grid.Column="0"
                        FontSize="14"
                        ImageSource="ic_forward.png"
                        ContentLayout="Left,8"
                        Style="{StaticResource OutlineButton}"
                        Clicked="OnForwardClicked" />
                <Button x:Name="ReplyButton"
                        Grid.Column="1"
                        FontSize="14"
                        ImageSource="ic_reply_w.png"
                        ContentLayout="Left,8"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnReplyClicked" />
            </Grid>
            <!-- La regla de reenvio automatico va a lo ancho: su texto no cabia en media fila -->
            <Button x:Name="ForwardRuleButton"
                    FontSize="14"
                    ImageSource="ic_settings.png"
                    ContentLayout="Left,10"
                    Style="{StaticResource OutlineButton}"
                    Clicked="OnForwardRuleClicked" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
