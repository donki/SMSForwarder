<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de SMS Forwarder (constitucion General 8.6). La app es un solo proyecto MAUI para
    Android: aqui se enlaza todo su codigo salvo Platforms/ (modelos, reglas, servicios, paginas con
    su XAML, Shell, App y MauiProgram) y se compila para net10.0 con Microsoft.Maui.Controls (MIT),
    que funciona sin dispositivo ni handlers. Lo que las paginas piden al dispositivo pasa por
    Services/AppPlatform.cs y aqui lo sustituyen dobles (Fakes.cs); el buzon y la agenda de Android,
    dobles de IMessageStore e IContactPicker. FileSystem y Preferences, las cuñas de Shims/.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SMSForwarder.Tests</RootNamespace>
    <!-- El codigo enlazado de la app arrastra avisos de nulabilidad que no son de las pruebas. -->
    <NoWarn>$(NoWarn);CS8625;CS0436</NoWarn>
    <UseMaui>true</UseMaui>
    <SingleProject>false</SingleProject>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)coverlet.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit (Apache-2.0), su runner (Apache-2.0), Microsoft.NET.Test.Sdk (MIT) y coverlet (MIT): solo para probar, no se distribuyen. -->
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Maui.Storage" />
  </ItemGroup>

  <!-- Codigo de la app que se prueba (enlazado, no copiado): todo menos Platforms/. -->
  <ItemGroup>
    <Compile Include="..\**\*.cs" Exclude="..\obj\**;..\bin\**;..\Platforms\**;..\SMSForwarder.Tests\**;..\constitution\**;..\_RECUPERADO_DEL_DLL\**;..\Release\**;..\artifacts\**" Link="App\%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiXaml Include="..\**\*.xaml" Exclude="..\obj\**;..\bin\**;..\Platforms\**;..\SMSForwarder.Tests\**;..\constitution\**;..\_RECUPERADO_DEL_DLL\**;..\Release\**;..\artifacts\**" Link="App\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Piezas comunes (repo sOCShared) que usa la app; no cuentan en la cobertura (coverlet.runsettings). -->
    <Compile Include="..\..\Shared\AuthorNotes.cs" Link="Shared\AuthorNotes.cs" />
    <Compile Include="..\..\Shared\ModernDialog.cs" Link="Shared\ModernDialog.cs" />
    <Compile Include="..\..\Shared\CrashGuard.cs" Link="Shared\CrashGuard.cs" />
  </ItemGroup>

</Project>
