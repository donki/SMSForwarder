<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SMSForwarder.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SMSForwarder"
    xmlns:pages="clr-namespace:SMSForwarder.Pages"
    xmlns:mauiControls="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
    Shell.FlyoutBehavior="Flyout"
    Title="SMS Forwarder"
    Shell.ForegroundColor="{StaticResource Primary}"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
    Shell.UnselectedColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
    Shell.DisabledColor="{StaticResource SeparatorLight}"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
    FlyoutWidth="260">

    <!-- Icono y título en la barra superior -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*"
              Padding="0">
            <Image Source="app_logo.svg"
                   HeightRequest="24"
                   VerticalOptions="Center"/>
            <Label Grid.Column="1"
                   Text="SMS Forwarder"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="8,0,0,0"/>
        </Grid>
    </Shell.TitleView>

    <!-- Formato de menú canónico (constitución A.9): cada fila lleva el icono del FlyoutIcon
         a la izquierda del texto, con color por tokens de tema para que no quede invisible en
         modo oscuro. -->
    <Shell.ItemTemplate>
        <DataTemplate x:DataType="mauiControls:BaseShellItem">
            <Grid HeightRequest="52"
                  Padding="20,0"
                  ColumnDefinitions="24,*"
                  ColumnSpacing="16">
                <Image Grid.Column="0"
                       Source="{Binding FlyoutIcon}"
                       HeightRequest="22"
                       WidthRequest="22"
                       Aspect="AspectFit"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       VerticalOptions="Center"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- Header del menú con safe area (cabecera canónica: logo + nombre + tagline) -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Primary}"
              HeightRequest="150"
              Padding="20,40,20,20">
            <VerticalStackLayout VerticalOptions="Center"
                                 Spacing="6">
                <Image Source="app_logo.svg"
                       HeightRequest="52"
                       WidthRequest="52"
                       HorizontalOptions="Start"/>
                <Label x:Name="HeaderTitle"
                       Text="SMS Forwarder"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnPrimary}"
                       HorizontalOptions="Start"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem x:Name="MessagesItem"
                Title="Mensajes"
                FlyoutIcon="messages.svg">
        <ShellContent
            Title="Mensajes"
            ContentTemplate="{DataTemplate pages:MessagesPage}"
            Route="MessagesPage"/>
    </FlyoutItem>

    <FlyoutItem x:Name="SettingsItem"
                Title="Configuración"
                FlyoutIcon="settings.svg">
        <ShellContent
            Title="Configuración"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage"/>
    </FlyoutItem>

    <FlyoutItem x:Name="DiagnosticsItem"
                Title="Diagnósticos"
                FlyoutIcon="diagnostics.svg">
        <ShellContent
            Title="Diagnósticos"
            ContentTemplate="{DataTemplate local:DiagnosticsPage}"
            Route="DiagnosticsPage"/>
    </FlyoutItem>

    <FlyoutItem x:Name="AboutItem"
                Title="Acerca de"
                FlyoutIcon="about.svg">
        <ShellContent
            Title="Acerca de"
            ContentTemplate="{DataTemplate pages:AboutPage}"
            Route="AboutPage"/>
    </FlyoutItem>

    <!-- Footer del menú -->
    <Shell.FlyoutFooter>
        <Grid Padding="20,12">
            <Label x:Name="FooterVersion"
                   Text="v2026.08.02.0"
                   FontSize="12"
                   Style="{StaticResource HintText}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
