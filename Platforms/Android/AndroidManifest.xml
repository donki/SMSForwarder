<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
  <!-- Permisos esenciales para SMS forwarding y funcionamiento en background -->
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.SEND_SMS" />
  <!-- Rol de app de SMS por defecto: READ_SMS para listar el buzon del sistema (pantalla Mensajes).
       Los 4 componentes obligatorios (SMS_DELIVER, WAP_PUSH_DELIVER, SENDTO, RESPOND_VIA_MESSAGE)
       se generan por atributos C# en Platforms/Android (SmsDeliverReceiver, MmsDeliverReceiver,
       ComposeSmsActivity, HeadlessSmsSendService). No se piden permisos de MMS: la app no gestiona
       MMS (el receptor WAP_PUSH es no-op y califica por el componente, no por el permiso). -->
  <uses-permission android:name="android.permission.READ_SMS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- Avisar con una notificacion cuando llega un SMS nuevo (Android 13+ requiere permiso en runtime). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!--
    Sin READ_CONTACTS a proposito: elegir un numero se hace con el selector del sistema
    (ACTION_PICK), que delega la lectura del contacto elegido. Lo exige la politica de
    Google Play sobre acceso amplio a contactos (obligatoria 2026-10-28). Ver ContactPicker.
  -->
  <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
  <uses-feature android:name="android.hardware.telephony" android:required="true" />
  <supports-screens
    android:anyDensity="true"
    android:smallScreens="true"
    android:normalScreens="true"
    android:largeScreens="false"
    android:xlargeScreens="false" />

  <application
		android:allowBackup="true"
		android:supportsRtl="true"
		android:label="SMS Forwarder"
		android:icon="@mipmap/appicon"
		android:theme="@style/Maui.SplashTheme">

    <!-- Receptor SMS -->
    <receiver
			android:name="com.socratic.smsforwarder.SMSReceiver"
			android:enabled="true"
			android:exported="true"
			android:label="SMS Receiver"
			android:permission="android.permission.BROADCAST_SMS">
      <intent-filter android:priority="2147483647">
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
